# Copy this file to .env and fill in your Spotify app credentials from
# https://developer.spotify.com/dashboard
#
# The redirect URI below MUST be registered exactly (scheme, host, port and
# path) in your app's settings on the Spotify dashboard. Spotify requires an
# explicit loopback IP for local redirect URIs, "localhost" is not accepted.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional: space-separated list of scopes to request at login. Leave unset
# to use the CLI's built-in default set (see internal/config/config.go).
# SPOTIFY_SCOPES=user-read-private user-read-email
